{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {},
    "color": {
      "palette": [
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "common-black",
          "color": "#2B2B2B",
          "name": "Common Black"
        },
        {
          "slug": "black-600",
          "color": "#555555",
          "name": "Black 600"
        },
        {
          "slug": "light-grey",
          "color": "#E9EAE8",
          "name": "Light Grey"
        },
        {
          "slug": "green",
          "color": "#256137",
          "name": "Green"
        },
        {
          "slug": "light-green",
          "color": "#C0D2C5",
          "name": "Light Green"
        },
        {
          "slug": "orange",
          "color": "#E19730",
          "name": "Orange"
        },
        {
          "slug": "background",
          "color": "#F9F9F9",
          "name": "Background"
        }
      ],
      "gradients": [
        {
          "slug": "brand-grey-gradient",
          "name": "Brand Grey Gradient",
          "gradient": "linear-gradient(180deg,rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 1) 70%, rgba(153, 153, 153, 1) 100%)"
        },
        {
          "slug": "brand-sunny-gradient",
          "name": "Brand Sunny Gradient",
          "gradient": "linear-gradient(102.64deg, #E5A848 37.92%, #E19730 74.23%);"
        }
      ]
    },
    "custom": {},
    "dimensions": {},
    "position": {},
    "shadow": {},
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Header",
          "slug": "header",
          "fontFamily": "Roboto"
        },
        {
          "name": "Body",
          "slug": "body",
          "fontFamily": "Poppins"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "18px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "20px",
          "fluid": false
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "35px"
        },
        {
          "name": "Extra extra Large",
          "slug": "xx-large",
          "size": "60px"
        }
      ]
    },
    "useRootPaddingAwareAlignments": false,
    "blocks": {}
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "18px"
    },
    "blocks": {
      "core/button": {
        "typography": {
          "fontWeight": "500"
        }
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      }
    }
  }
}
